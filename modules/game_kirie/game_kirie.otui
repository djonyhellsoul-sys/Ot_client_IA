MainWindow
  id: kirieWindow
  !text: tr('Kirie IA - Controle')
  size: 220 180

  Button
    id: buttonStartPause
    !text: tr('Iniciar IA')
    width: 140
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15

  Button
    id: buttonSaveClose
    !text: tr('Salvar e Fechar')
    width: 140
    anchors.top: buttonStartPause.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15

  Button
    id: buttonToggleWindow
    !text: tr('Fechar Painel')
    width: 140
    anchors.top: buttonSaveClose.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
